    {
      "name": "Hotel APIs",
      "item": [
        {
          "name": "Delhi - All Hotels",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Response is successful\", function () {",
                  "    pm.expect(json.success).to.eql(true);",
                  "});",
                  "",
                  "pm.test(\"Returns 5 unique Delhi hotels\", function () {",
                  "    pm.expect(json.data).to.have.length(5);",
                  "});",
                  "",
                  "pm.test(\"No duplicate hotel names\", function () {",
                  "    const names = json.data.map(hotel => hotel.name);",
                  "    pm.expect(new Set(names).size).to.eql(names.length);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
