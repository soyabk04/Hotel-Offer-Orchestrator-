        {
          "name": "Delhi - Price Filter",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=5000&maxPrice=8500",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                },
                {
                  "key": "minPrice",
                  "value": "5000"
                },
                {
                  "key": "maxPrice",
                  "value": "8500"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Response is successful\", function () {",
                  "    pm.expect(json.success).to.eql(true);",
                  "});",
                  "",
                  "pm.test(\"All hotels are within price range\", function () {",
                  "    json.data.forEach(hotel => {",
                  "        pm.expect(hotel.price).to.be.at.least(5000);",
                  "        pm.expect(hotel.price).to.be.at.most(8500);",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Returns expected 3 hotels\", function () {",
                  "    pm.expect(json.data).to.have.length(3);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
